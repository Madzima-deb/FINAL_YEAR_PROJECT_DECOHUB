# ── DecoHub Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: http://localhost:5173/api/auth/google/callback (dev)
#                               https://yourdomain.com/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# ── Apple Sign-In ─────────────────────────────────────────────────────────────
# 1. Apple Developer account: https://developer.apple.com/account/resources/identifiers/list
# 2. Register App ID or Services ID (e.g. com.decohub.web)
# 3. Enable 'Sign In with Apple', configure Return URL:
#    - Dev:  https://<your-ngrok-or-tunnel>.ngrok-free.app/api/auth/apple/callback
#    - Prod: https://yourdomain.com/api/auth/apple/callback
#    (Note: Apple strictly requires HTTPS for return URLs)
# 4. Generate a Private Key (.p8 file) under Keys → 'Sign In with Apple'
APPLE_CLIENT_ID=com.yourdomain.serviceid
APPLE_TEAM_ID=YOUR_10_CHAR_TEAM_ID
APPLE_KEY_ID=YOUR_10_CHAR_KEY_ID
# Multi-line .p8 key content (either with literal newlines or \n escaped)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── JWT Secret ────────────────────────────────────────────────────────────────
# A long random string to sign session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=change_this_to_a_random_secret_in_production

